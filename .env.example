# Copy to .env. The Exa key is the only one you truly need.

# Discovery — Exa recommended (https://exa.ai). A raw key is all it takes:
EXA_API_KEY=
# TAVILY_API_KEY=

# Optional: if you use 1Password, store an `op://` reference instead of the raw
# value and webfetch resolves it via the `op` CLI at runtime. Get the exact
# reference from the 1Password app: right-click the field -> Copy Secret Reference.
# EXA_API_KEY=op://Private/Exa/credential

# Optional managed clean-content engine (else Playwright is used):
# FIRECRAWL_API_KEY=
# WEBFETCH_ENGINE=firecrawl

# Rate limiting & retries (retries on 429/5xx are on by default)
# WEBFETCH_MIN_INTERVAL=1.0     # seconds between requests to the same host
# WEBFETCH_MAX_RETRIES=3
# WEBFETCH_RETRY_BACKOFF=0.5

# Proxy / IP masking — rotation: point WEBFETCH_PROXY at a rotating-gateway
# provider, or give WEBFETCH_PROXIES a pool rotated per request.
# WEBFETCH_PROXY=http://user:pass@host:port
# WEBFETCH_PROXIES=http://p1:port,http://p2:port
# WEBFETCH_PROXY_HOSTS=data.gov.in,nikshay.in   # proxy ONLY these hosts (else direct)
# For region-locked (e.g. India-only) sites: point WEBFETCH_PROXY at an in-country
# exit (residential country=IN, or an AWS Mumbai box / ssh -D socks5://localhost:1080
# with `uv sync --extra socks`) and scope it with WEBFETCH_PROXY_HOSTS.

# Optional paths / behavior
# WEBFETCH_CACHE_DIR=~/.cache/webfetch
# WEBFETCH_STATE=~/.config/webfetch/storage_state.json
# WEBFETCH_CACHE_TTL=86400
# WEBFETCH_ALLOW_PRIVATE=1   # allow localhost/intranet fetches (off by default)
