# Copy to .env. The Exa key is the only one you truly need.
#
# Using 1Password? Store an `op://` reference instead of the raw value —
# webfetch resolves it with the `op` CLI at runtime (you must be signed in).
# Get the exact reference from the 1Password app: right-click the field ->
# "Copy Secret Reference". Adjust the vault/item/field below to match yours.

# Discovery — Exa recommended (https://exa.ai). Use a reference OR a raw key:
EXA_API_KEY=op://Private/Exa/credential
# EXA_API_KEY=your-raw-exa-key
# TAVILY_API_KEY=op://Private/Tavily/credential

# Optional managed clean-content engine (else Playwright is used):
# FIRECRAWL_API_KEY=op://Private/Firecrawl/credential
# WEBFETCH_ENGINE=firecrawl

# Optional paths / behavior
# WEBFETCH_CACHE_DIR=~/.cache/webfetch
# WEBFETCH_STATE=~/.config/webfetch/storage_state.json
# WEBFETCH_CACHE_TTL=86400
