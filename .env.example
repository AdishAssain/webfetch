# Copy to .env. The Exa key is the only one you truly need.

# Discovery — Exa recommended (https://exa.ai). A raw key is all it takes:
EXA_API_KEY=
# TAVILY_API_KEY=

# Optional: if you use 1Password, store an `op://` reference instead of the raw
# value and webfetch resolves it via the `op` CLI at runtime. Get the exact
# reference from the 1Password app: right-click the field -> Copy Secret Reference.
# EXA_API_KEY=op://Private/Exa/credential

# Optional managed clean-content engine (else Playwright is used):
# FIRECRAWL_API_KEY=
# WEBFETCH_ENGINE=firecrawl

# Optional paths / behavior
# WEBFETCH_CACHE_DIR=~/.cache/webfetch
# WEBFETCH_STATE=~/.config/webfetch/storage_state.json
# WEBFETCH_CACHE_TTL=86400
# WEBFETCH_ALLOW_PRIVATE=1   # allow localhost/intranet fetches (off by default)
